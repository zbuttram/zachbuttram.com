---
import { Image } from "astro:assets"
import { faLinkedin, faSquareGithub } from "@fortawesome/free-brands-svg-icons"
import Base from "../layouts/Base.astro"
import LinkOut from "../components/LinkOut.astro"
import me from "../assets/me.jpg"
---

<Base
  title="Zach Buttram"
  description="Zach Buttram, software engineer specializing in web application development."
>
  <div class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center px-4 pt-10 pb-[38vh] md:pt-16">
    <h1 class="my-name" data-text="Zach Buttram">
      Zach Buttram
    </h1>
    <p class="aurebesh" aria-hidden="true">
      Zach Buttram
    </p>

    <figure class="retro-window mt-10 w-64 md:w-72">
      <figcaption class="retro-window-bar">
        <span>me.jpg</span>
        <span class="retro-window-buttons" aria-hidden="true">
          <span>_</span>
          <span>□</span>
          <span>×</span>
        </span>
      </figcaption>
      <div class="retro-window-body">
        <Image
          src={me}
          alt="Zach Buttram"
          loading="eager"
          class="block aspect-square w-full object-cover"
        />
      </div>
    </figure>

    <nav class="mt-10 flex w-full max-w-sm flex-col gap-4">
      <LinkOut href="https://github.com/zbuttram" icon={faSquareGithub}>
        GitHub
      </LinkOut>
      <LinkOut href="https://linkedin.com/in/zbuttram" icon={faLinkedin}>
        LinkedIn
      </LinkOut>
    </nav>
  </div>
</Base>
