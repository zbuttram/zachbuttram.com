---
// Full-viewport canvas of stars flying toward the viewer.
---

<canvas
  id="starfield"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full"
></canvas>

<script>
  const canvas = document.getElementById("starfield") as HTMLCanvasElement
  const ctx = canvas.getContext("2d")!
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

  const STAR_COUNT = 450
  const DEPTH = 1000
  const SPEED = 1.6
  const TINTS = ["#ffffff", "#ffffff", "#ffd6f5", "#9ff6ff", "#ff71ce"]

  type Star = { x: number; y: number; z: number; pz: number; tint: string }

  let width = 0
  let height = 0
  let stars: Star[] = []

  const spawn = (z = Math.random() * DEPTH): Star => ({
    x: (Math.random() - 0.5) * 2,
    y: (Math.random() - 0.5) * 2,
    z,
    pz: z,
    tint: TINTS[Math.floor(Math.random() * TINTS.length)],
  })

  const resize = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    width = window.innerWidth
    height = window.innerHeight
    canvas.width = width * dpr
    canvas.height = height * dpr
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
  }

  const project = (coord: number, z: number, scale: number) =>
    (coord / (z / DEPTH)) * scale

  const draw = (moving: boolean) => {
    ctx.clearRect(0, 0, width, height)
    // Vanishing point sits a bit above center, near the sun on the horizon.
    const cx = width / 2
    const cy = height * 0.42
    const scale = Math.max(width, height) * 0.5

    for (const star of stars) {
      star.pz = star.z
      if (moving) star.z -= SPEED
      if (star.z < 1) Object.assign(star, spawn(DEPTH))

      const sx = cx + project(star.x, star.z, scale)
      const sy = cy + project(star.y, star.z, scale)
      if (sx < 0 || sx > width || sy < 0 || sy > height) {
        if (moving) Object.assign(star, spawn(DEPTH))
        continue
      }

      const closeness = 1 - star.z / DEPTH
      const px = cx + project(star.x, star.pz, scale)
      const py = cy + project(star.y, star.pz, scale)

      ctx.globalAlpha = Math.min(1, closeness * 1.4)
      ctx.strokeStyle = star.tint
      ctx.lineWidth = 0.4 + closeness * 2.2
      ctx.lineCap = "round"
      ctx.beginPath()
      ctx.moveTo(px, py)
      ctx.lineTo(sx + 0.01, sy)
      ctx.stroke()
    }
    ctx.globalAlpha = 1
  }

  let frame = 0
  const loop = () => {
    draw(true)
    frame = requestAnimationFrame(loop)
  }

  const start = () => {
    cancelAnimationFrame(frame)
    if (reduceMotion.matches) draw(false)
    else loop()
  }

  stars = Array.from({ length: STAR_COUNT }, () => spawn())
  resize()
  start()

  window.addEventListener("resize", () => {
    resize()
    if (reduceMotion.matches) draw(false)
  })
  reduceMotion.addEventListener("change", start)
</script>
