---
import { icon as renderIcon } from "@fortawesome/fontawesome-svg-core"
import type { IconDefinition } from "@fortawesome/fontawesome-svg-core"

interface Props {
  href: string
  icon: IconDefinition
}

const { href, icon } = Astro.props
const svg = renderIcon(icon, { classes: ["fa-lg"] }).html.join("")
---

<a href={href} class="neon-link">
  <Fragment set:html={svg} />
  <span>
    <slot />
  </span>
  <span class="neon-link-arrow" aria-hidden="true">
    ▶
  </span>
</a>
